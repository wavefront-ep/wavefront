{
  "name": "ep-heart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-scenarios.mjs",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "assets": "tools/.venv/bin/python tools/build_heart.py && tools/.venv/bin/python tools/build_conduction.py",
    "build:offline": "npm run build && node scripts/build-offline.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
